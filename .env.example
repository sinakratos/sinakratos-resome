# Run npm run setup to create secure local credentials.
ADMIN_PASSWORD=replace-with-a-password-at-least-16-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=data/resume.sqlite
# Managed hosting normally uses port 3000.
PORT=3000
APP_HOST=0.0.0.0
# Exact public URL on the host; also enables Secure cookies for HTTPS.
# PUBLIC_ORIGIN=https://sinakratos.ir
