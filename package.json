    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76",
    "sharp": "0.35.4",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
