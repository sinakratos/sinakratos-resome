{
  "name": "sinakratos-resume",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
